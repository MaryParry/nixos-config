{
    "workbench.colorTheme": "Pink Cat Boo",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal",
        "kilo-code.new.agentManager.previousTerminal",
        "kilo-code.new.agentManager.nextTerminal"
    ],
    "workbench.iconTheme": "vscode-icons",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "pyright.analysis.diagnosticMode": "openFilesOnly",
    "vsicons.dontShowNewVersionMessage": true,
    "kilo-code.new.agentWorkStyle": "unset",
    "workbench.colorCustomizations": {
        "statusBar.foreground": "#000000",
        "statusBar.debuggingForeground": "#000000",
        "statusBar.noFolderForeground": "#000000"
    },
    "files.autoSave": "afterDelay",
    "editor.fontFamily": "SF Mono",
    "keyboard.dispatch": "keyCode",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "vscode-neovim.neovimExecutablePaths.linux": "/etc/profiles/per-user/saponela/bin/nvim",
    "terminal.integrated.defaultProfile.linux": "fish",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "editor.fontVariations": false,
    "explorer.confirmDragAndDrop": false
}
